{
  "name": "backend_v2",
  "packageManager": "yarn@4.8.1",
  "scripts": {
    "start": "yarn build && NODE_ENV=production pm2 start dist/main.js --name backend_v2",
    "dev": "NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start:dev": "node --watch dist/main.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "typeorm:migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "typeorm:migration:create": "npm run typeorm -- migration:create",
    "typeorm:migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "typeorm:migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "typeorm:migration:show": "npm run typeorm -- migration:show -d src/data-source.ts",
    "migration:run:prod": "NODE_ENV=production npm run typeorm:migration:run",
    "migration:show:prod": "NODE_ENV=production npm run typeorm:migration:show",
    "migration:revert:prod": "NODE_ENV=production npm run typeorm:migration:revert",
    "seed:categories": "NODE_ENV=development ts-node src/seeds/category.seed.ts",
    "seed:books": "NODE_ENV=development ts-node src/seeds/book.seed.ts",
    "seed:discover-category": "NODE_ENV=development ts-node src/seeds/discover-category.seed.ts",
    "seed:user": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/user.seed.ts",
    "seed:library": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/library.seed.ts",
    "seed:review": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/review.seed.ts",
    "seed:search": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/search.seed.ts",
    "seed:notification": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/notification.seed.ts",
    "seed:reading-status": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/reading-status.seed.ts",
    "seed:library-tag": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/library-tag.seed.ts",
    "seed:aladin-library": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/aladin-library.seed.ts",
    "seed:book-cover-dimensions": "NODE_ENV=development ts-node -r tsconfig-paths/register src/seeds/book-cover-image-dimensions.seed.ts",
    "seed:all": "yarn seed:categories && yarn seed:books && yarn seed:discover-category && yarn seed:user && yarn seed:library && yarn seed:review && yarn seed:search && yarn seed:notification && yarn seed:reading-status && yarn seed:library-tag",
    "seed:run-all": "NODE_ENV=development ts-node src/seeds/seed-all.ts",
    "seed:category": "ts-node -r tsconfig-paths/register src/seeds/category.seed.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/swagger": "^11.1.2",
    "@nestjs/typeorm": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/passport-apple": "^2.0.3",
    "axios": "^1.9.0",
    "cache-manager": "^6.4.3",
    "cache-manager-redis-store": "^3.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "googleapis": "^149.0.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.3.3",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.9.13",
    "passport-apple": "^2.0.2",
    "passport-kakao": "^1.0.1",
    "passport-naver-v2": "^2.0.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.22",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^11.1.0",
    "verify-apple-id-token": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-kakao": "^1.0.3",
    "@types/passport-local": "^1.0.38",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "version": "1.22.0"
}
